# Copy to .env.local for development, or set these in your host's environment
# for production. No real values belong in this file — it is committed.
#
# Without RESEND_API_KEY and LEAD_FROM_EMAIL, /api/contact and /api/careers
# return 503 and both forms tell the visitor to email directly. That is
# deliberate: the alternative is accepting submissions and discarding them.

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Sender address, on a domain verified in Resend. Resend rejects sends from
# unverified domains, so there is no useful default.
# Example: LEAD_FROM_EMAIL="PAWAAC site <website@pawaac.com>"
LEAD_FROM_EMAIL=

# Where demo requests and job applications are delivered.
# Optional — defaults to kshitij@pawaac.com.
LEAD_TO_EMAIL=
